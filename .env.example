# Copy is created as `.env` on first import if `.env` is missing (see config.py).
# Fill TELEGRAM_* so every agent signal + aggregator alerts go to your chat.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 1 (default) = send every raw agent signal to Telegram. 0 = only urgent/high/critical (filtered).
TELEGRAM_FORWARD_ALL=1

# Set to 1 in production if you must not start without Telegram.
TRADINGBOT_REQUIRE_TELEGRAM=0

LOG_LEVEL=INFO
# Optional: WARNING to hide INFO in console (file logs still follow LOG_LEVEL).
# CONSOLE_LOG_LEVEL=INFO

# Symbol universe (comma-separated). Default: 45 pairs in core/trading_symbols.py
# DEFAULT_SYMBOLS=BTCUSDT,ETHUSDT,...
AGG_MIN_SCORE=0.35
AGG_MIN_MARGIN=0.12
AGG_MIN_UNIQUE_AGENTS=2
AGG_DIRECTIONAL_MIN_CONFIDENCE=0.58
AGG_REQUIRE_QUALITY_AGENT_FOR_BUY=1
AGG_REQUIRE_QUALITY_AGENT_FOR_SELL=1
AGG_BEARISH_REGIME_ENABLED=1
AGG_BTC_TREND_FILTER_ENABLED=1
AGG_BTC_TREND_LOOKBACK_MINUTES=30
AGG_BTC_TREND_DOWN_THRESHOLD_PCT=-0.08
AGG_BTC_TREND_UP_THRESHOLD_PCT=0.08
AGG_BTC_SYMBOL=BTCUSDT
AGG_STRATEGY_MODE=defensive
AGG_STRATEGY_MIN_CONFIDENCE=0.60
AGG_STRATEGY_REQUIRED_CONFIRMATIONS=3
OUTCOME_HORIZON_HOURS=0.5

# Live aggregator EV gate (filters weak directional entries).
AGG_EV_GATE_ENABLED=1
AGG_EV_FEE_BPS_PER_SIDE=2
AGG_EV_SLIPPAGE_BPS=3
AGG_EV_BUFFER_BPS=6
AGG_EV_CONFIDENCE_MULT=16
AGG_EV_MARGIN_MULT=20
AGG_EV_SOURCE_MULT=3
AGG_EV_BEARISH_PENALTY_MULT=6
AGG_EV_EMERGENCY_PENALTY_MULT=4
AGG_EV_CONFLICT_PENALTY_MULT=25

# R:R gate: require expected edge >= trading costs + min profit (15 bps = 0.15%).
AGG_RR_GATE_ENABLED=1
AGG_RR_MIN_PROFIT_BPS=15

# Outcome-based edge calibration (per confidence bucket).
AGG_EDGE_CALIBRATION_ENABLED=1
AGG_EDGE_CALIBRATION_HOURS=720
AGG_EDGE_CALIBRATION_MIN_SAMPLES=30
AGG_EDGE_CALIBRATION_MIN_HIT_RATE=0.45
AGG_EDGE_CALIBRATION_WEAK_RETURN_PCT=0.05

# ML win-probability gate (train via train_signal_model.py)
AGG_ML_GATE_ENABLED=1
AGG_ML_MIN_WIN_PROB=0.42

# Asymmetric SL/TP (tight stop, wide take — profitable ~32% WR at RR 1:3)
AGG_SL_PCT=0.35
AGG_TP_RR_RATIO=3.0
AGG_MIN_RR_RATIO=2.5
AGG_USE_SL_TP_EXITS=1

# SMC structure gate (trend → sweep → BOS → retest)
AGG_STRUCTURE_GATE_ENABLED=1
AGG_STRUCTURE_HTF_MINUTES=240
AGG_STRUCTURE_LTF_MINUTES=15
AGG_STRUCTURE_MIN_RR=3.0
AGG_STRUCTURE_MID_RANGE_BLOCK_PCT=0.40
AGG_STRUCTURE_RETEST_TOLERANCE_PCT=0.15
AGG_STRUCTURE_SETUP_TTL_SEC=14400
AGG_STRUCTURE_SCAN_INTERVAL_SEC=60
AGG_STRUCTURE_REQUIRE_HTF_TREND=1
AGG_STRUCTURE_BLOCK_RANGE=1

# Analyst mode: score setups 0-100; Telegram alerts by quality threshold.
ANALYST_MODE=1
ANALYST_READY_MIN_SCORE=78
ANALYST_FORMING_MIN_SCORE=70
ANALYST_MIN_WIN_PROBABILITY=0.50
ANALYST_REPORT_HOURS=24
ANALYST_MAX_ALERTS_PER_DAY=0
ANALYST_MAX_FORMING_ALERTS_PER_DAY=0
ANALYST_FORMING_ALERTS_ENABLED=0
ANALYST_STRUCTURE_ONLY_TELEGRAM=1
ANALYST_EXIT_ALERTS_ENABLED=0
ANALYST_READY_ALERT_COOLDOWN_SEC=0
ANALYST_READY_DEDUPE_SEC=1800
ANALYST_VOLUME_SPIKE_ALERTS_ENABLED=1
ANALYST_VOLUME_SPIKE_DEDUPE_SEC=3600
VOLUME_SPIKE_THRESHOLD=2.5
ANALYST_FORMING_ONLY_RETEST=1
ANALYST_CONTINUATION_READY_MIN_SCORE=76
ANALYST_CONTINUATION_MIN_WIN_PROBABILITY=0.48
AGG_STRUCTURE_CONTINUATION_ENABLED=1
AGG_STRUCTURE_CONTINUATION_MIN_HOLD_BARS=4
AGG_STRUCTURE_CONTINUATION_MIN_WAIT_BARS=6
AGG_STRUCTURE_CONTINUATION_MIN_DISPLACEMENT_PCT=0.25
