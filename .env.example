# Copy is created as `.env` on first import if `.env` is missing (see config.py).
# Fill TELEGRAM_* so every agent signal + aggregator alerts go to your chat.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 1 (default) = send every raw agent signal to Telegram. 0 = only urgent/high/critical (filtered).
TELEGRAM_FORWARD_ALL=1

# Set to 1 in production if you must not start without Telegram.
TRADINGBOT_REQUIRE_TELEGRAM=0

LOG_LEVEL=INFO
# Optional: WARNING to hide INFO in console (file logs still follow LOG_LEVEL).
# CONSOLE_LOG_LEVEL=INFO

# Aggregator entry quality (fewer but stronger trades).
AGG_MIN_SCORE=0.35
AGG_MIN_MARGIN=0.12
AGG_MIN_UNIQUE_AGENTS=2
AGG_DIRECTIONAL_MIN_CONFIDENCE=0.58
AGG_REQUIRE_QUALITY_AGENT_FOR_BUY=1
AGG_BEARISH_REGIME_ENABLED=1
AGG_BTC_TREND_FILTER_ENABLED=1
AGG_BTC_TREND_LOOKBACK_MINUTES=30
AGG_BTC_TREND_DOWN_THRESHOLD_PCT=-0.08
AGG_BTC_TREND_UP_THRESHOLD_PCT=0.08
AGG_BTC_SYMBOL=BTCUSDT
AGG_STRATEGY_MODE=defensive
AGG_STRATEGY_MIN_CONFIDENCE=0.60
AGG_STRATEGY_REQUIRED_CONFIRMATIONS=3
OUTCOME_HORIZON_HOURS=0.5

# Live aggregator EV gate (filters weak directional entries).
AGG_EV_GATE_ENABLED=1
AGG_EV_FEE_BPS_PER_SIDE=2
AGG_EV_SLIPPAGE_BPS=3
AGG_EV_BUFFER_BPS=6
AGG_EV_CONFIDENCE_MULT=16
AGG_EV_MARGIN_MULT=20
AGG_EV_SOURCE_MULT=3
AGG_EV_BEARISH_PENALTY_MULT=6
AGG_EV_EMERGENCY_PENALTY_MULT=4
AGG_EV_CONFLICT_PENALTY_MULT=25

# R:R gate: require expected edge >= trading costs + min profit (15 bps = 0.15%).
AGG_RR_GATE_ENABLED=1
AGG_RR_MIN_PROFIT_BPS=15

# Outcome-based edge calibration (per confidence bucket).
AGG_EDGE_CALIBRATION_ENABLED=1
AGG_EDGE_CALIBRATION_HOURS=720
AGG_EDGE_CALIBRATION_MIN_SAMPLES=30
AGG_EDGE_CALIBRATION_MIN_HIT_RATE=0.45
AGG_EDGE_CALIBRATION_WEAK_RETURN_PCT=0.05
